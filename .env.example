# The bot token from your Fluxer application (Applications -> your app -> bot token).
FLUXER_BOT_TOKEN=

# Where your instance answers the API. fluxer.com itself is https://api.fluxer.app ;
# a self-hosted instance is usually https://<your-host>/api
FLUXER_API_BASE=https://api.fluxer.app/api

# The guild this bot is invited to, for the one-shot CLI commands.
FLUXER_GUILD_ID=

# Optional: the prefix for text commands. Slash commands are not wired yet.
WIZARDRY_PREFIX=!wiz

# Optional: pin the gateway URL instead of asking the API for it.
# FLUXER_GATEWAY_URL=wss://gateway.fluxer.app
